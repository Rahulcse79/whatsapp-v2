# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
local.properties

# Android
*.apk
*.aab
*.ap_
*.dex
*.class
captures/
.externalNativeBuild/
.cxx/
output.json

# PJSIP binaries (ADR-006). Built by .github/workflows/build-pjsip.yml and fetched from
# its artifact; ~30 MB of native code that changes with every pjproject or NDK bump, and
# not something git should be carrying. See docs/pjsip-migration.md P-2.
pjsip/libs/*.aar

# Keystores & secrets — never commit (ADR-005 / §7)
*.jks
*.keystore
keystore.properties
signing.properties
google-services.json
freeswitch.properties

# IDE
.idea/
!.idea/icon.png
*.iml
.kotlin/

# OS
.DS_Store
Thumbs.db

# Logs / reports
*.log
log.txt
*.hprof
lint-results*.html
lint-results*.xml

# Task plans — working notes, kept on the machine and out of the repository.
# The `Done when` detail they carry is the author's scratch record, not a contract
# anybody clones this repository to read; docs/ holds what an outside reader needs.
tasks.md
tasks-v*.md
