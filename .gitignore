# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
local.properties

# ...but NOT inside the vendored trees (N-2). `build/` above is Gradle's output directory;
# in pjproject and libvpx it is the *build system itself* — `third_party/pjproject/build/`
# holds the .mak files every target includes. Without these negations git silently drops
# nine directories and the vendored tree cannot build, with no error saying why.
#
# Verified with `git check-ignore -v`, and `tools/vendor/verify-vendored.sh` fails the
# build if the file count on disk and the count git tracks ever diverge again.
!third_party/**/build/
!third_party/**/build/**

# Android
*.apk
*.aab
*.ap_
*.dex
*.class
captures/
.externalNativeBuild/
.cxx/
output.json

# No PJSIP binary is ignored here any more, because none exists (ADR-007, N-1). The
# native stack is built from third_party/ by `:pjsip`, and its output lands under
# `build/` like every other build output. Architecture rule 11 fails the build on a
# committed .aar or .so — an ignore rule is a convention that `git add -f` defeats
# silently, and a rule is not.

# Keystores & secrets — never commit (ADR-005 / §7)
*.jks
*.keystore
keystore.properties
signing.properties
google-services.json
freeswitch.properties

# IDE
.idea/
!.idea/icon.png
*.iml
.kotlin/

# OS
.DS_Store
Thumbs.db

# Logs / reports
*.log
log.txt
*.hprof
lint-results*.html
lint-results*.xml

# Task plans — working notes, kept on the machine and out of the repository.
# The `Done when` detail they carry is the author's scratch record, not a contract
# anybody clones this repository to read; docs/ holds what an outside reader needs.
tasks.md
tasks-v*.md

# Eclipse / IDE class output. These duplicate every source file, and the architecture
# test walks the source tree — so a stale `bin/` makes it scan the deliberate violation
# fixtures under test/arch and fail every rule at once, locally and only locally.
bin/
