# WhatsApp V2 push gateway — environment for the systemd unit.
# Copy to /etc/coraltelecom/coralx-push-sender.env and edit. Contains NO secrets:
# the Firebase key is supplied by the unit's LoadCredential=, not from here.

# FreeSWITCH event socket (mod_event_socket). Local to the server.
ESL_ADDR=127.0.0.1:8021
ESL_PASSWORD=ClueCon

# Operator API — health, token and call inspection, manual push. Loopback only;
# expose it through a reverse proxy with auth if it must be reached off-box.
HTTP_ADDR=127.0.0.1:8085

# Only accept push tokens minted under this FCM sender id (the pn-param on the
# REGISTER Contact). FCM HTTP v1 is project-scoped, so a token from another
# project cannot be delivered to with this unit's key; without this, another
# product's handsets registering on the same SIP domain have their tokens stored
# here and pushed to. Empty accepts every project (the previous behaviour).
FCM_SENDER_ID=

# debug | info | warn | error
LOG_LEVEL=info

# NOTE: data-dir and the service-account path are NOT set here.
#   - the token store is StateDirectory (/var/lib/coralx-push-sender), set by systemd
#   - the FCM key is LoadCredential=fcm-key, read from
#     /etc/coraltelecom/whatsapp-39dcb-fcm.json at /etc/coraltelecom/... (root:root, 0600)
# This is what keeps WhatsApp V2's key separate from Sanchar's
# /etc/coraltelecom/sanchar-d8f1c-*.json sitting in the same directory.
