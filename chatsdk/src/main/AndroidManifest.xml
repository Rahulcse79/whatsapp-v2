<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the host app's manifest. INTERNET is the only thing the SDK needs;
     it starts no services and shows no notifications of its own - what to do when a
     message arrives is the host's decision, delivered through ChatListener. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
