<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ConnectivityNetworkMonitor calls registerDefaultNetworkCallback, getActiveNetwork
      and getNetworkCapabilities. All three are guarded by this permission.

      Declared here and not only in :app because the requirement belongs to the module
      that has it. Manifest merging carries it into any consuming app, and lint analyses
      each module against its OWN merged manifest - :app declaring the permission does
      not make these call sites legal in :data:sip, which is exactly what run
      33951547581 reported.

      A normal permission, not a dangerous one: granted at install and never requested
      at runtime, which is why it has no AppPermission entry beside the others.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      AlarmWakeTimer keeps registrations alive through deep sleep with AlarmManager
      (network/WakeTimer.kt says why nothing else can). Two things it needs:

      SCHEDULE_EXACT_ALARM makes the alarms exact on Android 12+. It is user-grantable
      ("Alarms & reminders" in the app's settings), and an app the user has excluded from
      battery optimisation is exempt from needing it at all. When neither holds the timer
      falls back to an inexact alarm, which still fires through doze, up to 75% late — and
      the recovery coordinator sizes its keepalive so that "late" is still inside the lease.

      WAKE_LOCK holds the CPU for the ten seconds after an alarm in which the REGISTER is
      sent and answered. :app declares it too; it is declared here because the call site
      is here (the same reasoning as ACCESS_NETWORK_STATE above).
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!--
          The alarm's destination. Manifest-declared so the intent is explicit and the
          platform delivers it whether or not the process is alive. Not exported: only
          AlarmManager, acting as this app, ever sends it.
        -->
        <receiver
            android:name=".network.platform.WakeTimerReceiver"
            android:exported="false" />
    </application>

</manifest>
