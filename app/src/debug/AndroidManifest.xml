<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug-only. HiltTestActivity hosts Compose tests that need an @AndroidEntryPoint
      Activity for hiltViewModel(); it is not exported and never ships in a release build.
    -->
    <application>
        <activity
            android:name=".HiltTestActivity"
            android:exported="false" />

        <!--
          Debug-only. Configures LeakCanary before Application.onCreate; see the class.
        -->
        <provider
            android:name=".leaks.LeakCanaryConfigProvider"
            android:authorities="${applicationId}.leakcanary-config"
            android:exported="false" />
    </application>

</manifest>
