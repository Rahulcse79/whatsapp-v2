<?xml version="1.0" encoding="utf-8"?>
<!--
  The round launcher icon, which is the same three layers.

  A separate file because `android:roundIcon` is a separate manifest attribute and some
  launchers ask for it by name. The masking is the launcher's either way — see
  ic_launcher.xml for why the foreground is a bitmap and the plate is not.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
