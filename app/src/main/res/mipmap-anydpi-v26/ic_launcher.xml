<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon (Task 66).

  Three layers, not a bitmap: the launcher masks background and foreground to its own
  shape and parallaxes them, and <monochrome> is what lets Android 13+ tint the icon to
  the user's wallpaper instead of dropping a coloured square into a themed home screen.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
