<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's background: the plate the Coral Telecom mark is drawn on.

  White, where it used to be the near-black #02192B that the previous CoralX mark was
  keyed off. That is forced by the artwork rather than chosen: the Coral Telecom lockup
  is dark navy type on a white ground, and on a near-black plate the words disappear
  entirely. The mark's own ground is white, so a white plate is also the one colour that
  cannot show a seam where the keyed edges meet it.

  Not quite flat. The gradient runs from pure white to #F4F6F8 over the full height, which
  is barely a shade and is there for the same reason the old plate was lightened towards
  the top: a perfectly flat tile reads as a missing icon on a light launcher, and a
  suggestion of a lit surface stops that without tinting the artwork sitting on it.

  Still a vector, because a plate is one path and a gradient; only the mark itself has to
  be a bitmap.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0" android:color="#FFFFFF" />
                <item android:offset="1" android:color="#F4F6F8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
