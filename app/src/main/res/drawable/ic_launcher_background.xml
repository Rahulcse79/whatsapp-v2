<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's background: the plate the CoralX mark is drawn on.

  #02192B is not a colour somebody chose here - it is the median of every pixel the mark
  was keyed off in the supplied artwork, so the icon's ground is literally the artwork's
  ground and the mark sits on it without a seam. Lightened a little towards the top, the
  way the original is lit.

  Still a vector, because a flat plate is two paths and a gradient; only the mark itself
  had to become a bitmap.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0" android:color="#0A2A44" />
                <item android:offset="1" android:color="#02192B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
