<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's background: the brand green, lit from above.

  #00874E to #00512C - either side of Green40 (#006D3B), the primary in
  :core:designsystem - so the icon reads as the same product as the app it opens.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:startColor="#FF00874E"
                android:endColor="#FF00512C" />
        </aapt:attr>
    </path>
</vector>
