<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared here, modelled in AppPermission, and requested in context by
      PermissionCoordinator. Each one has a rationale and a defined behaviour when it is
      refused - see AppPermission.deniedExplanation.

      The foreground-service and Telecom entries arrive with the tasks that need them
      (28, 34, 51); declaring them before anything starts a service would be asking for
      capability the app cannot yet use.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:minSdkVersion="31" />

    <!--
      An incoming call must reach the lock screen (Task 37). From Android 14 this is
      granted only to apps whose core function is calling, which this app's is; a device
      that withholds it still shows the heads-up notification, which stays answerable.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      The proximity screen-off lock, held only while a call is on the earpiece (Task 40).
      No wake lock is held while unregistered (§6) - ProximityLock releases on every route
      that is not the earpiece and on the end of every call.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Vibrating for an incoming call, and only when the ringer says to (Task 37).
      RingerPolicy decides; without this permission the buzz silently does nothing, which
      is the kind of failure nobody notices until a call is missed in a meeting.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Foreground service. Two types, matching what the service is actually doing:
      specialUse while only holding a registration - which is not a phone call, a data
      sync, or any other standard type - and phoneCall once a call is in progress.
      Declaring registration as a phone call would be a false claim about behaviour.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Video calling is optional: the app must install on devices without a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!--
      Deliberately minimal. Permissions, the foreground service and its types, the
      Telecom ConnectionService and CallStyle notifications are declared by the tasks
      that introduce them (15, 28, 34, 37, 51).

      android:allowBackup is false from the first commit because this app stores SIP
      credentials, and backup would copy them off the device (§7, DoD 12).
    -->
    <application
        android:name=".SipApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="whatsapp-v2"
        android:supportsRtl="true"
        android:theme="@style/Theme.WhatsAppV2">

        <service
            android:name=".service.RegistrationService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a SIP registration so incoming calls can be received while the app is in the background." />
        </service>

        <!--
          Telecom's entry point (Task 34, §3). The permission is what tells the platform
          only Telecom may bind this, and Telecom refuses a ConnectionService that does
          not declare it - the service is simply never called and calls never appear.
        -->
        <service
            android:name=".telecom.SipConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!--
          The call screen (Tasks 37, 39). Its own task and its own activity because a
          full-screen intent needs one, and because it must show over the keyguard without
          dragging the rest of the app onto the lock screen with it.

          singleTask: one call screen, whichever of the three ways opened it - the dialler,
          a notification, or the platform's own answer button.

          excludeFromRecents: a finished call has no screen worth returning to, and leaving
          one in the recents list invites someone to reopen a call that is over.
        -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:taskAffinity=".call"
            android:theme="@style/Theme.WhatsAppV2" />

        <!--
          The notification's answer and decline buttons. Not exported: nothing outside this
          app may end or answer a call.
        -->
        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false" />

        <!--
          The push wake path (Task 38, ADR-004). Fires only when Firebase is configured for
          the build; with no google-services.json the SDK never delivers a message and this
          service is simply never called, which is the honest behaviour for a deployment
          that has no push gateway yet.
        -->
        <service
            android:name=".push.SipMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="whatsapp-v2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
