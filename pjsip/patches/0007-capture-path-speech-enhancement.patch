+         */
+        pj_status_t enh_status = pjmedia_speech_enh_create(pool,
+                                                         snd_port->clock_rate,
+                                                         snd_port->channel_count,
+                                                         snd_port->samples_per_frame,
+                                                         0,
+                                                         &snd_port->speech_enh);
+        if (enh_status == PJ_SUCCESS) {
+            snd_port->prm_ec_options &= ~PJMEDIA_ECHO_USE_NOISE_SUPPRESSOR;
+        } else {
