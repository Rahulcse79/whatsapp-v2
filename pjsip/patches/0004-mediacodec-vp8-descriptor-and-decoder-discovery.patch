 #define API_AT_LEAST(x) __builtin_available(android x, *)
 
 typedef struct and_med_buf_info {
@@ -221,6 +276,194 @@ typedef struct and_media_codec_data
     pj_size_t                    dec_input_buf_max_size;
     pj_ssize_t                   dec_input_buf_idx;
